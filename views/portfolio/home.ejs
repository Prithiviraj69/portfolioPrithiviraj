      <% if (locals.profile && profile.skills && profile.skills.length > 0) { %>
        <% profile.skills.forEach(skill => { %>
          <div class="skill-card tech-skill-card" data-category="<%= skill.category.toLowerCase().replace(/[^\w]+/g, '-') %>">
            <div class="skill-header-meta">
              <span class="skill-cat-tag"><%= skill.category %></span>
              <span class="skill-status-dot"></span>
            </div>
            <div class="skill-icon">
              <% if (skill.icon && skill.icon.startsWith('<')) { %>
                <%- skill.icon %>
              <% } else if (skill.icon) { %>
                <img src="<%= skill.icon %>" alt="<%= skill.name %>">
              <% } else { %>
                <i class="fa-solid fa-code"></i>
              <% } %>
            </div>
            <div class="skill-name"><%= skill.name %></div>
          </div>
        <% }) %>
      <% } else { %>
        <!-- Default Skill Cards -->
        <div class="skill-card tech-skill-card" data-category="back-end">
          <div class="skill-icon"><i class="devicon-nodejs-plain colored"></i></div>
          <div class="skill-name">Node.js</div>
        </div>
      <% } %>
    </div>
  </div>
</section>

