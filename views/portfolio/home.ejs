<!-- Projects Section -->
<section id="projects" class="projects-section high-tech-section">
  <div class="container">
    <div class="section-header-tech">
      <div class="section-kicker">Portfolio &amp; Case Studies</div>
      <h2 class="tech-section-title">Systems Engineered for Scale &amp; Compliance</h2>
      <p class="tech-section-subtitle">Mission-critical e-Governance platforms, cryptographic workflows, and optimized distributed architectures built for real-world impact.</p>
    </div>
    
    <div class="projects-filter tech-filter-bar">
      <button class="project-filter-btn active" data-filter="all">All Projects</button>
      <% 
        // Extract unique categories from projects
        let categories = [];
        if (locals.projects && projects.length > 0) {
          categories = [...new Set(projects.map(project => project.category))];
        }
      %>
      <% if (categories.length > 0) { %>
        <% categories.forEach(category => { %>
          <button class="project-filter-btn" data-filter="<%= category.toLowerCase().replace(/\s+/g, '-') %>"><%= category %></button>
        <% }) %>
      <% } else { %>
        <button class="project-filter-btn" data-filter="government">Government</button>
        <button class="project-filter-btn" data-filter="web-portal">Web Portals</button>
        <button class="project-filter-btn" data-filter="enterprise">Enterprise</button>
        <button class="project-filter-btn" data-filter="next-js-ai">Next.js &amp; AI</button>
        <button class="project-filter-btn" data-filter="mobile-backend">Mobile Backend</button>
      <% } %>
    </div>
    
    <div class="projects-grid tech-projects-grid">
      <% if (locals.projects && projects.length > 0) { %>
        <% projects.forEach((project, idx) => { %>
          <div class="project-card tech-project-card" data-category="<%= project.category.toLowerCase().replace(/\s+/g, '-') %>">
            <div class="project-card-header-bar">
              <span class="card-sys-id">Production</span>
              <span class="card-cat-badge"><%= project.category %></span>
            </div>
            <div class="project-image">
              <img src="<%= project.coverImage %>" alt="<%= project.title %>">
              <div class="project-image-overlay">
                <span class="view-overlay-btn"><i class="fa-solid fa-expand"></i></span>
              </div>
            </div>
            <div class="project-info">
              <h3 class="project-title">
                <% if (project.demoUrl) { %>
                  <a href="<%= project.demoUrl %>" target="_blank" rel="noopener noreferrer"><%= project.title %> <i class="fa-solid fa-arrow-up-right-from-square title-ext-icon"></i></a>
                <% } else { %>
                  <a href="/projects/<%= project.slug %>"><%= project.title %></a>
                <% } %>
              </h3>
              <p class="project-description"><%= project.description %></p>
              
              <div class="project-tech-pills">
                <% project.techStack.forEach(t => { %>
                  <span class="tech-pill"><%= t %></span>
                <% }) %>
              </div>

              <div class="project-card-footer">
                <% if (project.demoUrl) { %>
                  <a href="<%= project.demoUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-card-primary">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Live Portal
                  </a>
                <% } %>
                <% if (project.githubUrl) { %>
                  <a href="<%= project.githubUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-card-outline">
                    <i class="fab fa-github"></i> Source Code
                  </a>
                <% } %>
                <a href="/projects/<%= project.slug %>" class="btn btn-card-link">
                  Case Study <i class="fa-solid fa-chevron-right"></i>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <!-- Fallback Cards -->
        <div class="project-card tech-project-card" data-category="government">
          <div class="project-card-header-bar">
            <span class="card-sys-id">Production</span>
            <span class="card-cat-badge">Government</span>
          </div>
          <div class="project-image">
            <img src="/images/projects/labour-compliance.svg" alt="Digital Labour Compliance Portal">
          </div>
          <div class="project-info">
            <h3 class="project-title">Digital Labour Compliance &amp; Regulatory Portal</h3>
            <p class="project-description">Enterprise e-Governance website built to simplify and digitize all factory registrations, licensing, and compliance matrices under the 4 New Labour Codes. Integrated SBIePay Payment Gateway, Cyber Treasury module, and Hardware PKI DSC Signing Suite (Watchdata ProxKey) with secure QR verification.</p>
            <div class="project-tech-pills">
              <span class="tech-pill">Node.js</span>
              <span class="tech-pill">Express.js</span>
              <span class="tech-pill">MongoDB</span>
              <span class="tech-pill">PKI Cryptography</span>
              <span class="tech-pill">SBIePay</span>
              <span class="tech-pill">Redis</span>
            </div>
            <div class="project-card-footer">
              <a href="/projects/digital-labour-compliance-portal" class="btn btn-card-link">Case Study <i class="fa-solid fa-chevron-right"></i></a>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

